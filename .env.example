# Acompanhe.IA — variáveis de ambiente (copie para .env e preencha)

# ── Núcleo ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/acompanhe
JWT_SECRET=troque-por-um-segredo-longo-openssl-rand-hex-32
ADMIN_TOKEN=senha-inicial-do-diretor-do-painel
NODE_ENV=development          # development | test | production (dev-auth some em production)
PORT=3000
HOST=0.0.0.0

# ── Telegram ────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:cole-o-token-do-botfather
# WEBHOOK_URL=              # opcional; sem ele o bot usa long polling

# ── Pagamentos (PushinPay) — sem token o checkout entra em modo visível ──
PUSHINPAY_API_BASE=https://api.pushinpay.com.br
# PUSHINPAY_TOKEN=          # credencial real (cashIn PIX)
PUSHINPAY_WEBHOOK_SECRET=whsec-troque
PUBLIC_BASE_URL=https://seu-dominio       # webhook_url do PIX

# ── Worker (entrega de alertas via Telegram) ────────────────────────────
WORKER_INTERVAL_MS=30000

# ── OSINT (Investiga) ───────────────────────────────────────────────────
SHERLOCK_BIN=/home/user/tools/sherlock.sh

# ── Painel do administrador ─────────────────────────────────────────────
# diretor é criado no boot com ADMIN_TOKEN; troque a senha em /v1/admin/auth/password
